{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DBConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ArticleProjectDB;Trusted_Connection=True;MultipleActiveResultSets=true;"
  },
  "FrontendSettings": {
    "BaseUrl": "http://localhost:3000/ArticleProjectWeb/"
  },
  "ScheduledJobs": {
    "FetchScopusDataJob": {
      //"CronExpression": "0 0 12 ? * MON", //Seconds	Minutes	Hours	Day Of Month	Month	Day Of Week || -> YEAR
      "CronExpression": "*/5 * * * * *",
      "Enabled": false
    }
  },
  "CorsSettings": {
    "Origins": [ "http://localhost:3000" ],
    "Methods": [ "GET", "POST" ]
  }
}